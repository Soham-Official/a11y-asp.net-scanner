# Copy this file to .env (it is gitignored) and fill in your HAIP_API_KEY.
#
#   cp .env.example .env
#
# Get a key from the AI Platform - Team 1 Teams channel. The other values
# below default to working dev settings (matching what nuxeo-ai-package
# uses today). You can override any of them.
#
# IMPORTANT: never commit .env. The .gitignore already excludes it.

# === REQUIRED ===

# Bearer token from AI Platform Team 1. Rotates every 90 days.
HAIP_API_KEY=

# === OPTIONAL (defaults shown work for dev) ===

# Public dev endpoint. Reachable from a developer laptop without VPC.
# Use https://ai-platform.api.ai.dev.app.hyland.com for the private/VPC
# endpoint when running inside the shared VPC (e.g. CI).
HAIP_BASE_URL=https://ai-platform-public.api.ai.dev.app.hyland.com

# HAIP environment / region: dev | staging | prod | prod-eu | prod-au.
# V1 only supports dev. Default: dev.
HAIP_ENV=dev

# Service-account or user identifier sent in HAIP metadata for audit logs.
# Default: a11y-scout-service.
HAIP_USER_ID=a11y-scout-service

# Optional. HAIP dev no longer requires it; set this only if your team
# enforces environment scoping or you want usage attribution per HX env.
# HAIP_ENVIRONMENT_ID=

# App key for usage reporting in Nucleus. Default: a11y-scout.
HAIP_APP_KEY=a11y-scout

# === MODEL DEFAULTS ===
#
# The default HAIP team key is restricted to "default_models". The full
# allowlist (verified via API) includes:
#   openai.gpt-oss-120b-1:0      <- V1.1 default reasoner
#   openai.gpt-oss-20b-1:0       <- V1.1 default cheap classifier
#   qwen.qwen3-next-80b-a3b
#   qwen.qwen3-vl-235b-a22b      (vision-capable, useful for V2)
#   zai.glm-4.7
#   moonshotai.kimi-k2.5
#   mistral.ministral-3-14b-instruct
#   google.gemma-3-27b-it
#   nvidia.nemotron-super-3-120b
#   meta.llama3-8b-instruct-v1:0 (no tool use; avoid for JSON output)
#
# If your team has Claude entitlements, set:
#   HAIP_MODEL_REASONER=anthropic.claude-3-5-sonnet-20241022-v2:0
HAIP_MODEL_REASONER=openai.gpt-oss-120b-1:0
HAIP_MODEL_CHEAP=openai.gpt-oss-20b-1:0

# Hard cap per scan in USD. Scans abort if exceeded. Default: 1.00.
A11Y_MAX_COST_USD=1.00

# Set to "1" to force mock mode even when an API key is present.
# Useful for offline development and CI.
# A11Y_HAIP_MOCK=1

# === LLM PROVIDER (for fix-repo command) ===
#
# The fixer auto-detects which LLM provider to use:
# - "bedrock" = AWS Bedrock (via Claude Code or AWS credentials)
# - "haip" = HAIP Model Gateway (production)
# - "mock" = Mock mode (testing, no real API calls)
#
# Auto-detection priority:
# 1. A11Y_LLM_PROVIDER env var (if set)
# 2. CLAUDE_CODE_USE_BEDROCK=1 or AWS_PROFILE → bedrock
# 3. HAIP_API_KEY set → haip
# 4. Default → haip (will run in mock if no key)
#
# Explicitly set provider (optional):
# A11Y_LLM_PROVIDER=bedrock
# A11Y_LLM_PROVIDER=haip
# A11Y_LLM_PROVIDER=mock
