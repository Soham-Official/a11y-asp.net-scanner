{
  "name": "@a11y-scout/webdriverio",
  "version": "0.3.1",
  "description": "Drop-in WebdriverIO helper that runs a11y-scout against any page rendered during a WebdriverIO test.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "a11y-scout": "0.3.0"
  },
  "peerDependencies": {
    "webdriverio": ">=8"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "playwright": "^1.49.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.8",
    "webdriverio": "^9.0.0"
  },
  "license": "UNLICENSED"
}
